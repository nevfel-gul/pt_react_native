rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─────────────────────────────────────────────────────────────
    // Bu dosya Firestore güvenlik kurallarının TEK kaynağıdır.
    // Konsoldan elle değiştirmeyin; buradan deploy edin:
    //   firebase deploy --only firestore:rules
    //
    // Cloud Functions Admin SDK kullandığı için bu kurallardan etkilenmez.
    // ─────────────────────────────────────────────────────────────

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Abonelik (users/{uid}.subscription) Apple'dan doğrulanarak SUNUCUDA
    // yazılır (functions/src/billing/appleBilling.ts). 1.2 ve öncesi sürümler
    // aboneliği hâlâ istemciden yazıyor; o kullanıcılar güncelleyene kadar
    // istemci yazımına geçici olarak izin veriliyor.
    //
    // TODO: 1.3+ kullanıcıların çoğunluğa ulaşınca `false` yap ve deploy et.
    // O andan sonra kimse kendi hesabını istemciden premium yapamaz.
    function clientMaySetSubscription() {
      return true;
    }

    function subscriptionUntouched() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['subscription']);
    }

    // Fiyatlar artık tamamen StoreKit'ten geliyor; uygulama bu koleksiyonu
    // okumuyor. Eski veri için erişim bırakıldı ama giriş şartı eklendi.
    match /plans/{planId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /users/{userId} {
      allow read, delete: if isOwner(userId);
      allow create: if isOwner(userId)
        && (clientMaySetSubscription() || !('subscription' in request.resource.data));
      allow update: if isOwner(userId)
        && (clientMaySetSubscription() || subscriptionUntouched());

      match /students/{studentId} {
        allow read, write: if isOwner(userId);

        match /notes/{noteId} {
          allow read, write: if isOwner(userId);
        }

        // Seans / paket takibi (services/packages.ts)
        match /packages/{packageId} {
          allow read, write: if isOwner(userId);
        }
        match /sessions/{sessionId} {
          allow read, write: if isOwner(userId);
        }
      }

      match /records/{recordId} {
        allow read, write: if isOwner(userId);
      }

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(userId);
      }

      match /subscription_intents/{intentId} {
        allow read, write: if isOwner(userId);
      }

      match /promoCampaigns/{doc=**} { allow read, write: if false; }
      match /promoCoupons/{doc=**}   { allow read, write: if false; }
    }

    // Apple işlem kimliği → kullanıcı eşlemesi; sadece sunucu kullanır.
    match /appleTransactions/{doc=**} { allow read, write: if false; }

    // Yukarıda eşleşmeyen her yol Firestore tarafından zaten reddedilir.
  }
}
